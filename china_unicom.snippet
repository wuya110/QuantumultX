# name: 中国联通自动签到 (优化版)
# author: wuya110
# desc: 自动抓取 Cookie + 每日 8:30 自动签到

[rewrite_local]
# 匹配联通首页和签到接口抓取 Cookie (放宽了触发条件)
^https:\/\/(act|m|loginxhm)\.(client\.)?10010\.com\/(SigninApp\/signin\/querySignininfo|mobileService\/onLine\.htm) url script-request-header https://raw.githubusercontent.com/wuya110/QuantumultX/refs/heads/main/china_unicom.snippet

[task_local]
# 定时签到任务
30 8 * * * https://raw.githubusercontent.com/wuya110/QuantumultX/refs/heads/main/china_unicom.snippet, tag=联通自动签到, enabled=true

[hostname]
# 增加了你在抓包里实际访问的域名
hostname = act.10010.com, m.client.10010.com, loginxhm.10010.com

[script]
const $ = new Env("中国联通签到");
const ckKey = "unicom_ck_wuya";

if (typeof $request !== "undefined") {
  getCookie();
} else {
  checkin();
}

function getCookie() {
  if ($request.headers) {
    const ck = $request.headers["Cookie"] || $request.headers["cookie"];
    // 确保 Cookie 中包含联通核心的 ecs_token 才会保存
    if (ck && ck.indexOf("ecs_token=") > -1) {
      const oldCk = $.getdata(ckKey);
      // 加个判断，防止每次打开App都疯狂弹窗
      if (oldCk !== ck) {
        $.setdata(ck, ckKey);
        $.msg($.name, "✅ 获取 Cookie 成功", "账号数据已保存，可以关闭抓包并等待自动签到");
      }
    }
  }
  $.done();
}

async function checkin() {
  const ck = $.getdata(ckKey);
  if (!ck) {
    $.msg($.name, "❌ 签到失败", "请先手动打开一次联通App触发抓取 Cookie");
    $.done();
    return;
  }
  const options = {
    url: "https://act.10010.com/SigninApp/signin/daySign",
    headers: {
      "Cookie": ck,
      "Content-Type": "application/x-www-form-urlencoded",
      "User-Agent": "ChinaUnicom4.x/12.9 (com.chinaunicom.mobilebusiness; build:40; iOS 26.3.0)"
    },
    body: "imei="
  };
  $.post(options, (err, resp, data) => {
    try {
      const res = JSON.parse(data);
      if (res.code === "0000") {
        $.msg($.name, "🎉 签到成功", `奖励: ${res.data.prizeName || "积分"}`);
      } else {
        $.msg($.name, "⚠️ 签到结果", res.msg || "接口异常或今日已签到");
      }
    } catch (e) {
      $.msg($.name, "❌ 解析失败", "返回数据格式有误");
    }
    $.done();
  });
}

function Env(n) {
  this.name = n;
  this.getdata = (k) => $prefs.valueForKey(k);
  this.setdata = (v, k) => $prefs.setValueForKey(v, k);
  this.msg = (t, s, b) => $notify(t, s, b);
  this.post = (o, c) => $task.fetch(o).then(r => c(null, r, r.body), e => c(e, null, null));
  this.done = (v) => $done(v);
}
